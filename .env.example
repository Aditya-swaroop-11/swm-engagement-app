# Copy this file to ".env" and fill it in. Without SMTP_HOST + SMTP_PASSWORD, emails are NOT sent
# (each one is saved as an .eml file in data/outbox instead, so nothing is lost).

SENDER_EMAIL=hr@smartworkmart.com
SENDER_NAME=Smart Work Mart HR

# Ask whoever hosts hr@smartworkmart.com for these. Common examples:
#   Google Workspace : smtp.gmail.com  / 587 / starttls  (password = an "App Password", needs 2-step verification on)
#   Zoho Mail        : smtp.zoho.in    / 587 / starttls
#   Hostinger / cPanel : smtp.hostinger.com / 465 / ssl
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=hr@smartworkmart.com
SMTP_PASSWORD=

# Link behind the "COMPLETE ONBOARDING FORM" button in the email
ONBOARDING_FORM_URL=https://forms.gle/bvg44gZmw4HT8JyK6

# Associate ID = prefix + running number (first one is ID_START)
ID_PREFIX=SWM/TTL/2026/
ID_START=21078

# Login that protects the web page
APP_USERNAME=hr
APP_PASSWORD=

# Live Google Sheet (see SETUP_GUIDE.txt). Leave SHEET_WEBHOOK_URL empty to use the local Excel file.
SHEET_WEBHOOK_URL=
SHEET_SECRET=
SHEET_URL=
